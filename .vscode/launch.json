{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pipeline (all mock apps)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run pipeline (verbose handoff logs)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--verbose"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run failure-handling tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_failure_handling.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
